# Tool pins shared by .github/workflows/ci.yml and the scripts in .github/scripts/.
#
# Read two ways, so keep it valid for both: bash `source`s it, and CI appends it to
# $GITHUB_ENV (via load-versions.sh). That means plain KEY=value lines - no quotes,
# spaces, `export` or trailing comments - and comments on their own lines.
# load-versions.sh fails the job on any line that breaks this.

# --- Argo CD: these move together. On an Argo CD upgrade, bump ARGOCD_VERSION and
# the CRD checksum, and HELM_* to the Helm that release bundles
# (hack/tool-versions.sh in the argo-cd repo at that tag).
ARGOCD_VERSION=3.5.3
# sha256 of manifests/crds/application-crd.yaml at that tag
ARGOCD_CRD_SHA256=5dde0e229249b6b707beb98674c1deae3949d5c319a6c45b9f5a80c99618e40c
HELM_VERSION=4.2.1
HELM_SHA256=479dca836e5b45e8bd222400c5591b0e3a647378f03ff96597180db97c17fdae

# --- kubeconform, and the CRD-to-JSON-Schema converter from its repo at the same tag
KUBECONFORM_VERSION=0.8.0
KUBECONFORM_SHA256=9bc2bffbf71f261128533edaf912153948b7ff238f9a531ae6d34466ec287883
OPENAPI2JSONSCHEMA_SHA256=d145babfbb765004030764e1b4e518bfb7a4bd7f111691a08fa57983b81881f3

# --- Kubernetes schemas for rendered charts
# k3s version on the lab node
KUBE_VERSION=1.36.4
# commit of yannh/kubernetes-json-schema
SCHEMA_REF=a6f9a32d2ccb64b6e4f5b41419b9c2e8ee0cce18

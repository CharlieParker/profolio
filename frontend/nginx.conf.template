server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # BACKEND_URL is filled in from the container's env at start (envsubst)
    # no URI part on proxy_pass, so /api/... is forwarded to the backend unchanged
    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        try_files $uri /index.html;
    }
}
